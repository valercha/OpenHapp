#!/bin/sh

# OpenWrt rpcd executable plugin for OpenHapp.
# rpcd invokes this file as:
#   openhapp list
#   openhapp call <method>
# Method arguments are supplied on stdin.

case "$1" in
list)
	cat <<'EOF'
{"start": {}, "stop": {}, "status": {}, "config": {}, "manifest": {}, "snapshot": {}, "engine_info": {}}
EOF
	;;
call)
	[ -n "$2" ] || exit 1
	exec /usr/bin/openhappd-rpc --raw "$2"
	;;
*)
	exit 1
	;;
esac
